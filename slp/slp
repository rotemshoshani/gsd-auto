#!/usr/bin/env bash

set -u

usage() {
    printf 'Usage: slp [[HH:]MM:]SS\n' >&2
}

if [[ ${1:-} == "-h" || ${1:-} == "--help" ]]; then
    usage
    exit 0
fi

if [[ $# -ne 1 || ! $1 =~ ^([0-9]+:){0,2}[0-9]+$ ]]; then
    usage
    exit 2
fi

duration=$1
IFS=: read -r -a parts <<< "$duration"
hours=0
minutes=0
seconds=0

case ${#parts[@]} in
    1) seconds=$((10#${parts[0]})) ;;
    2)
        minutes=$((10#${parts[0]}))
        seconds=$((10#${parts[1]}))
        ;;
    3)
        hours=$((10#${parts[0]}))
        minutes=$((10#${parts[1]}))
        seconds=$((10#${parts[2]}))
        ;;
    *)
        usage
        exit 2
        ;;
esac

remaining=$((hours * 3600 + minutes * 60 + seconds))

while ((remaining > 0)); do
    printf '\rRemaining: %02d:%02d:%02d' \
        "$((remaining / 3600))" \
        "$(((remaining % 3600) / 60))" \
        "$((remaining % 60))"
    sleep 1
    ((remaining -= 1))
done

printf '\rRemaining: 00:00:00\nDone!\n'
